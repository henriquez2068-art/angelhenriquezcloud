{
  // ============================================================
  // PLANTILLA ARM - BASE DE RED DEL LABORATORIO INTEGRAL
  // ============================================================
  // Este archivo define la capa de red del laboratorio completo.
  // Su responsabilidad es crear las tres redes virtuales base:
  //   1. CoreServicesVnet
  //   2. ManufacturingVnet
  //   3. ResearchVnet
  //
  // Además, dentro de cada VNet define sus subredes embebidas.
  // Este diseño se dejó así para evitar problemas de concurrencia
  // como AnotherOperationInProgress, que pueden aparecer cuando
  // ARM intenta crear varias subredes de la misma VNet en paralelo
  // como recursos separados.
  //
  // IMPORTANTE:
  // - Este archivo es una copia comentada para estudio en VS Code.
  // - El archivo ejecutable sigue siendo: lab-network-template.json
  // - JSON no soporta comentarios de forma nativa.
  // - Por eso esta versión se entrega como JSONC.
  // ============================================================

  // Esquema oficial de plantillas ARM.
  // Ayuda al editor y al motor de despliegue a validar estructura.
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",

  // Versión interna de la plantilla.
  // No controla el versionado de Azure; es útil para documentación.
  "contentVersion": "1.0.0.0",

  // ============================================================
  // PARÁMETROS
  // ============================================================
  // Aquí definimos todos los valores externos que deben llegar desde
  // el archivo de parámetros. Esto hace que la plantilla sea flexible,
  // reutilizable y claramente dependiente del archivo
  // lab-network-parameters.json.
  "parameters": {
    // Nombres de las tres VNets del laboratorio.
    "coreVnetName": { "type": "string", "minLength": 2 },
    "manufacturingVnetName": { "type": "string", "minLength": 2 },
    "researchVnetName": { "type": "string", "minLength": 2 },

    // Ubicaciones de cada VNet.
    // Se dejaron separadas para que el laboratorio también muestre
    // que ARM permite desplegar recursos en distintas regiones.
    "coreLocation": { "type": "string", "minLength": 2 },
    "manufacturingLocation": { "type": "string", "minLength": 2 },
    "researchLocation": { "type": "string", "minLength": 2 },

    // Espacios de direccionamiento de cada VNet.
    // Cada uno se define como string tipo CIDR.
    "coreAddressSpace": { "type": "string", "minLength": 9 },
    "manufacturingAddressSpace": { "type": "string", "minLength": 9 },
    "researchAddressSpace": { "type": "string", "minLength": 9 },

    // ---------- CoreServicesVnet ----------
    // Parámetros para nombres y prefijos de cada subnet de la VNet core.
    "coreGatewaySubnetName": { "type": "string", "minLength": 2 },
    "coreGatewaySubnetPrefix": { "type": "string", "minLength": 9 },
    "coreSharedServicesSubnetName": { "type": "string", "minLength": 2 },
    "coreSharedServicesSubnetPrefix": { "type": "string", "minLength": 9 },
    "coreDatabaseSubnetName": { "type": "string", "minLength": 2 },
    "coreDatabaseSubnetPrefix": { "type": "string", "minLength": 9 },
    "corePublicWebSubnetName": { "type": "string", "minLength": 2 },
    "corePublicWebSubnetPrefix": { "type": "string", "minLength": 9 },

    // ---------- ManufacturingVnet ----------
    // Parámetros para la VNet del entorno de manufactura.
    "manufacturingSystemSubnetName": { "type": "string", "minLength": 2 },
    "manufacturingSystemSubnetPrefix": { "type": "string", "minLength": 9 },
    "manufacturingSensorSubnet1Name": { "type": "string", "minLength": 2 },
    "manufacturingSensorSubnet1Prefix": { "type": "string", "minLength": 9 },
    "manufacturingSensorSubnet2Name": { "type": "string", "minLength": 2 },
    "manufacturingSensorSubnet2Prefix": { "type": "string", "minLength": 9 },
    "manufacturingSensorSubnet3Name": { "type": "string", "minLength": 2 },
    "manufacturingSensorSubnet3Prefix": { "type": "string", "minLength": 9 },

    // ---------- ResearchVnet ----------
    // Parámetros para la subnet de investigación.
    "researchSystemSubnetName": { "type": "string", "minLength": 2 },
    "researchSystemSubnetPrefix": { "type": "string", "minLength": 9 },

    // Objeto de tags reutilizable para todos los recursos.
    "tags": { "type": "object" }
  },

  // ============================================================
  // RECURSOS
  // ============================================================
  // Aquí declaramos los recursos reales que Azure desplegará.
  // ARM se encargará de materializar este estado final.
  "resources": [
    {
      // --------------------------------------------------------
      // VNET 1: CoreServicesVnet
      // --------------------------------------------------------
      // Esta VNet es la más importante para el laboratorio,
      // porque dentro de ella vive DatabaseSubnet, que luego será
      // consumida por las máquinas virtuales en la plantilla de cómputo.
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2025-05-01",
      "name": "[parameters('coreVnetName')]",
      "location": "[parameters('coreLocation')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('coreAddressSpace')]"
          ]
        },
        "subnets": [
          {
            // Subnet reservada para gateways VPN/ER.
            "name": "[parameters('coreGatewaySubnetName')]",
            "properties": { "addressPrefix": "[parameters('coreGatewaySubnetPrefix')]" }
          },
          {
            // Subnet de servicios compartidos.
            "name": "[parameters('coreSharedServicesSubnetName')]",
            "properties": { "addressPrefix": "[parameters('coreSharedServicesSubnetPrefix')]" }
          },
          {
            // Subnet usada por el template de VMs.
            // Esta es la pieza de integración entre red y cómputo.
            "name": "[parameters('coreDatabaseSubnetName')]",
            "properties": { "addressPrefix": "[parameters('coreDatabaseSubnetPrefix')]" }
          },
          {
            // Subnet pensada para servicios web públicos.
            "name": "[parameters('corePublicWebSubnetName')]",
            "properties": { "addressPrefix": "[parameters('corePublicWebSubnetPrefix')]" }
          }
        ]
      }
    },
    {
      // --------------------------------------------------------
      // VNET 2: ManufacturingVnet
      // --------------------------------------------------------
      // Red orientada a un escenario industrial/manufactura.
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2025-05-01",
      "name": "[parameters('manufacturingVnetName')]",
      "location": "[parameters('manufacturingLocation')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('manufacturingAddressSpace')]"
          ]
        },
        "subnets": [
          {
            "name": "[parameters('manufacturingSystemSubnetName')]",
            "properties": { "addressPrefix": "[parameters('manufacturingSystemSubnetPrefix')]" }
          },
          {
            "name": "[parameters('manufacturingSensorSubnet1Name')]",
            "properties": { "addressPrefix": "[parameters('manufacturingSensorSubnet1Prefix')]" }
          },
          {
            "name": "[parameters('manufacturingSensorSubnet2Name')]",
            "properties": { "addressPrefix": "[parameters('manufacturingSensorSubnet2Prefix')]" }
          },
          {
            "name": "[parameters('manufacturingSensorSubnet3Name')]",
            "properties": { "addressPrefix": "[parameters('manufacturingSensorSubnet3Prefix')]" }
          }
        ]
      }
    },
    {
      // --------------------------------------------------------
      // VNET 3: ResearchVnet
      // --------------------------------------------------------
      // Red de investigación. En este laboratorio actúa como red
      // complementaria para mostrar despliegue multi-región.
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2025-05-01",
      "name": "[parameters('researchVnetName')]",
      "location": "[parameters('researchLocation')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('researchAddressSpace')]"
          ]
        },
        "subnets": [
          {
            "name": "[parameters('researchSystemSubnetName')]",
            "properties": { "addressPrefix": "[parameters('researchSystemSubnetPrefix')]" }
          }
        ]
      }
    }
  ],

  // ============================================================
  // OUTPUTS
  // ============================================================
  // Estas salidas son importantes porque exponen datos útiles una vez
  // termina el despliegue. Sirven para documentación, validación
  // y encadenamiento lógico con la siguiente fase del laboratorio.
  "outputs": {
    // Nombre final de la VNet principal.
    "coreVnetName": {
      "type": "string",
      "value": "[parameters('coreVnetName')]"
    },

    // Nombre final de la subnet principal que luego usarán las VMs.
    "coreDatabaseSubnetName": {
      "type": "string",
      "value": "[parameters('coreDatabaseSubnetName')]"
    },

    // Resource ID completo de la subnet donde se conectarán las VMs.
    "coreDatabaseSubnetResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('coreVnetName'), parameters('coreDatabaseSubnetName'))]"
    },

    // Outputs adicionales de referencia para otras VNets.
    "manufacturingVnetName": {
      "type": "string",
      "value": "[parameters('manufacturingVnetName')]"
    },
    "researchVnetName": {
      "type": "string",
      "value": "[parameters('researchVnetName')]"
    }
  }
}
