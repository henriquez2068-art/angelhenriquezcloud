{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": { "type": "string", "minLength": 2 },
    "existingVirtualNetworkName": { "type": "string", "minLength": 2 },
    "existingSubnetName": { "type": "string", "minLength": 2 },

    "vmName1": { "type": "string", "minLength": 2, "maxLength": 15 },
    "nicName1": { "type": "string", "minLength": 2 },
    "nsgName1": { "type": "string", "minLength": 2 },
    "publicIpName1": { "type": "string", "minLength": 2 },

    "vmName2": { "type": "string", "minLength": 2, "maxLength": 15 },
    "nicName2": { "type": "string", "minLength": 2 },
    "nsgName2": { "type": "string", "minLength": 2 },
    "publicIpName2": { "type": "string", "minLength": 2 },

    "vmSize": {
      "type": "string",
      "allowedValues": ["Standard_DS1_v2", "Standard_D2s_v3", "Standard_D2as_v5"]
    },
    "adminUsername": { "type": "string", "minLength": 3, "maxLength": 20 },
    "adminPassword": { "type": "secureString", "minLength": 12 },
    "windowsSku": {
      "type": "string",
      "allowedValues": ["2019-Datacenter", "2022-datacenter-azure-edition"]
    },
    "osDiskStorageAccountType": {
      "type": "string",
      "allowedValues": ["StandardSSD_LRS", "Premium_LRS"]
    },
    "rdpAllowedSourceAddressPrefix": { "type": "string", "minLength": 1 },
    "tags": { "type": "object" }
  },
  "variables": {
    "subnetResourceId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('existingVirtualNetworkName'), parameters('existingSubnetName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-10-01",
      "name": "[parameters('publicIpName1')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Standard", "tier": "Regional" },
      "tags": "[parameters('tags')]",
      "properties": {
        "publicIPAddressVersion": "IPv4",
        "publicIPAllocationMethod": "Static"
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-10-01",
      "name": "[parameters('publicIpName2')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Standard", "tier": "Regional" },
      "tags": "[parameters('tags')]",
      "properties": {
        "publicIPAddressVersion": "IPv4",
        "publicIPAllocationMethod": "Static"
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-10-01",
      "name": "[parameters('nsgName1')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "securityRules": [
          {
            "name": "allow-rdp-admin-source",
            "properties": {
              "priority": 1000,
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "3389",
              "sourceAddressPrefix": "[parameters('rdpAllowedSourceAddressPrefix')]",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "direction": "Inbound"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-10-01",
      "name": "[parameters('nsgName2')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "securityRules": [
          {
            "name": "allow-rdp-admin-source",
            "properties": {
              "priority": 1000,
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "3389",
              "sourceAddressPrefix": "[parameters('rdpAllowedSourceAddressPrefix')]",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "direction": "Inbound"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2024-10-01",
      "name": "[parameters('nicName1')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('nsgName1'))]",
        "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIpName1'))]"
      ],
      "tags": "[parameters('tags')]",
      "properties": {
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('nsgName1'))]"
        },
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "subnet": {
                "id": "[variables('subnetResourceId')]"
              },
              "privateIPAllocationMethod": "Dynamic",
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIpName1'))]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2024-10-01",
      "name": "[parameters('nicName2')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('nsgName2'))]",
        "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIpName2'))]"
      ],
      "tags": "[parameters('tags')]",
      "properties": {
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('nsgName2'))]"
        },
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "subnet": {
                "id": "[variables('subnetResourceId')]"
              },
              "privateIPAllocationMethod": "Dynamic",
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIpName2'))]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-11-01",
      "name": "[parameters('vmName1')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', parameters('nicName1'))]"
      ],
      "tags": "[parameters('tags')]",
      "properties": {
        "hardwareProfile": { "vmSize": "[parameters('vmSize')]" },
        "osProfile": {
          "computerName": "[parameters('vmName1')]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]",
          "windowsConfiguration": { "provisionVMAgent": true }
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "MicrosoftWindowsServer",
            "offer": "WindowsServer",
            "sku": "[parameters('windowsSku')]",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "[parameters('osDiskStorageAccountType')]"
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', parameters('nicName1'))]",
              "properties": { "primary": true }
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-11-01",
      "name": "[parameters('vmName2')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', parameters('nicName2'))]"
      ],
      "tags": "[parameters('tags')]",
      "properties": {
        "hardwareProfile": { "vmSize": "[parameters('vmSize')]" },
        "osProfile": {
          "computerName": "[parameters('vmName2')]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]",
          "windowsConfiguration": { "provisionVMAgent": true }
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "MicrosoftWindowsServer",
            "offer": "WindowsServer",
            "sku": "[parameters('windowsSku')]",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "[parameters('osDiskStorageAccountType')]"
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', parameters('nicName2'))]",
              "properties": { "primary": true }
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "existingVirtualNetworkName": { "type": "string", "value": "[parameters('existingVirtualNetworkName')]" },
    "existingSubnetName": { "type": "string", "value": "[parameters('existingSubnetName')]" },
    "subnetResourceId": { "type": "string", "value": "[variables('subnetResourceId')]" },
    "vm1ResourceId": { "type": "string", "value": "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName1'))]" },
    "vm2ResourceId": { "type": "string", "value": "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName2'))]" }
  }
}
