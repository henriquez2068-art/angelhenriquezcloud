{
  // ============================================================
  // PLANTILLA ARM - CAPA DE CÓMPUTO DEL LABORATORIO INTEGRAL
  // ============================================================
  // Esta plantilla crea dos máquinas virtuales Windows completas.
  // Cada una incluye:
  //   - Public IP
  //   - Network Security Group
  //   - Network Interface
  //   - Virtual Machine
  //
  // Además, esta plantilla NO crea la red.
  // La red debe existir previamente y fue diseñada para depender
  // de la plantilla de red del laboratorio.
  //
  // IMPORTANTE:
  // - Esta es una copia comentada para estudio en VS Code.
  // - El archivo ejecutable sigue siendo: lab-vm-template.json
  // - JSON no soporta comentarios nativos; por eso se entrega JSONC.
  // ============================================================

  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",

  // ============================================================
  // PARÁMETROS
  // ============================================================
  // Aquí viven todos los valores externos necesarios para el
  // despliegue de cómputo. La intención es que el archivo
  // lab-vm-parameters.json sea realmente necesario.
  "parameters": {
    // ----------------------------------------------------------
    // Parámetros de ubicación y red existente
    // ----------------------------------------------------------
    "location": { "type": "string", "minLength": 2 },
    "existingVirtualNetworkName": { "type": "string", "minLength": 2 },
    "existingSubnetName": { "type": "string", "minLength": 2 },

    // ----------------------------------------------------------
    // Identidad de VM 1
    // ----------------------------------------------------------
    "vmName1": { "type": "string", "minLength": 2, "maxLength": 15 },
    "nicName1": { "type": "string", "minLength": 2 },
    "nsgName1": { "type": "string", "minLength": 2 },
    "publicIpName1": { "type": "string", "minLength": 2 },

    // ----------------------------------------------------------
    // Identidad de VM 2
    // ----------------------------------------------------------
    "vmName2": { "type": "string", "minLength": 2, "maxLength": 15 },
    "nicName2": { "type": "string", "minLength": 2 },
    "nsgName2": { "type": "string", "minLength": 2 },
    "publicIpName2": { "type": "string", "minLength": 2 },

    // ----------------------------------------------------------
    // Parámetros de tamaño, credenciales y sistema operativo
    // ----------------------------------------------------------
    "vmSize": {
      "type": "string",
      // allowedValues restringe el tamaño a un conjunto controlado.
      // Esto evita errores y facilita la explicación didáctica.
      "allowedValues": ["Standard_DS1_v2", "Standard_D2s_v3", "Standard_D2as_v5"]
    },
    "adminUsername": { "type": "string", "minLength": 3, "maxLength": 20 },
    "adminPassword": { "type": "secureString", "minLength": 12 },
    "windowsSku": {
      "type": "string",
      // Se dejan dos SKUs válidos para laboratorio.
      "allowedValues": ["2019-Datacenter", "2022-datacenter-azure-edition"]
    },
    "osDiskStorageAccountType": {
      "type": "string",
      // Tipo de almacenamiento permitido para el disco del sistema.
      "allowedValues": ["StandardSSD_LRS", "Premium_LRS"]
    },

    // ----------------------------------------------------------
    // Parámetro de seguridad de acceso RDP
    // ----------------------------------------------------------
    "rdpAllowedSourceAddressPrefix": { "type": "string", "minLength": 1 },

    // Tags comunes.
    "tags": { "type": "object" }
  },

  // ============================================================
  // VARIABLES
  // ============================================================
  // Aquí derivamos el Resource ID completo de la subnet ya existente.
  // Es el puente técnico entre el despliegue de red y el despliegue
  // de máquinas virtuales.
  "variables": {
    "subnetResourceId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('existingVirtualNetworkName'), parameters('existingSubnetName'))]"
  },

  // ============================================================
  // RECURSOS
  // ============================================================
  // El orden lógico es:
  //   1. Public IPs
  //   2. NSGs
  //   3. NICs
  //   4. VMs
  "resources": [
    {
      // --------------------------------------------------------
      // PUBLIC IP 1
      // --------------------------------------------------------
      // Public IP moderna con SKU Standard.
      // Se usa Static para tener una IP más predecible.
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-10-01",
      "name": "[parameters('publicIpName1')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Standard", "tier": "Regional" },
      "tags": "[parameters('tags')]",
      "properties": {
        "publicIPAddressVersion": "IPv4",
        "publicIPAllocationMethod": "Static"
      }
    },
    {
      // PUBLIC IP 2
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-10-01",
      "name": "[parameters('publicIpName2')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Standard", "tier": "Regional" },
      "tags": "[parameters('tags')]",
      "properties": {
        "publicIPAddressVersion": "IPv4",
        "publicIPAllocationMethod": "Static"
      }
    },
    {
      // --------------------------------------------------------
      // NSG 1
      // --------------------------------------------------------
      // Grupo de seguridad para la primera NIC/VM.
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-10-01",
      "name": "[parameters('nsgName1')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "securityRules": [
          {
            // Regla de entrada RDP.
            "name": "allow-rdp-admin-source",
            "properties": {
              "priority": 1000,
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "3389",
              "sourceAddressPrefix": "[parameters('rdpAllowedSourceAddressPrefix')]",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "direction": "Inbound"
            }
          }
        ]
      }
    },
    {
      // NSG 2
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-10-01",
      "name": "[parameters('nsgName2')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "securityRules": [
          {
            "name": "allow-rdp-admin-source",
            "properties": {
              "priority": 1000,
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "3389",
              "sourceAddressPrefix": "[parameters('rdpAllowedSourceAddressPrefix')]",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "direction": "Inbound"
            }
          }
        ]
      }
    },
    {
      // --------------------------------------------------------
      // NIC 1
      // --------------------------------------------------------
      // La NIC 1 depende de:
      // - su NSG
      // - su Public IP
      // También consume la subnet existente, ya creada por la plantilla de red.
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2024-10-01",
      "name": "[parameters('nicName1')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('nsgName1'))]",
        "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIpName1'))]"
      ],
      "tags": "[parameters('tags')]",
      "properties": {
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('nsgName1'))]"
        },
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "subnet": {
                "id": "[variables('subnetResourceId')]"
              },
              "privateIPAllocationMethod": "Dynamic",
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIpName1'))]"
              }
            }
          }
        ]
      }
    },
    {
      // NIC 2
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2024-10-01",
      "name": "[parameters('nicName2')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('nsgName2'))]",
        "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIpName2'))]"
      ],
      "tags": "[parameters('tags')]",
      "properties": {
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('nsgName2'))]"
        },
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "subnet": {
                "id": "[variables('subnetResourceId')]"
              },
              "privateIPAllocationMethod": "Dynamic",
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIpName2'))]"
              }
            }
          }
        ]
      }
    },
    {
      // --------------------------------------------------------
      // VM 1
      // --------------------------------------------------------
      // La VM 1 se crea solo cuando su NIC ya existe.
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-11-01",
      "name": "[parameters('vmName1')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', parameters('nicName1'))]"
      ],
      "tags": "[parameters('tags')]",
      "properties": {
        "hardwareProfile": { "vmSize": "[parameters('vmSize')]" },
        "osProfile": {
          "computerName": "[parameters('vmName1')]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]",
          // provisionVMAgent habilita el agente de Azure en la VM.
          "windowsConfiguration": { "provisionVMAgent": true }
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "MicrosoftWindowsServer",
            "offer": "WindowsServer",
            "sku": "[parameters('windowsSku')]",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "[parameters('osDiskStorageAccountType')]"
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', parameters('nicName1'))]",
              "properties": { "primary": true }
            }
          ]
        }
      }
    },
    {
      // VM 2
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-11-01",
      "name": "[parameters('vmName2')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', parameters('nicName2'))]"
      ],
      "tags": "[parameters('tags')]",
      "properties": {
        "hardwareProfile": { "vmSize": "[parameters('vmSize')]" },
        "osProfile": {
          "computerName": "[parameters('vmName2')]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]",
          "windowsConfiguration": { "provisionVMAgent": true }
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "MicrosoftWindowsServer",
            "offer": "WindowsServer",
            "sku": "[parameters('windowsSku')]",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "[parameters('osDiskStorageAccountType')]"
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', parameters('nicName2'))]",
              "properties": { "primary": true }
            }
          ]
        }
      }
    }
  ],

  // ============================================================
  // OUTPUTS
  // ============================================================
  // Exponen valores útiles una vez finaliza el despliegue.
  "outputs": {
    "existingVirtualNetworkName": { "type": "string", "value": "[parameters('existingVirtualNetworkName')]" },
    "existingSubnetName": { "type": "string", "value": "[parameters('existingSubnetName')]" },
    "subnetResourceId": { "type": "string", "value": "[variables('subnetResourceId')]" },
    "vm1ResourceId": { "type": "string", "value": "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName1'))]" },
    "vm2ResourceId": { "type": "string", "value": "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName2'))]" }
  }
}
