{
  // ============================================================
  // ARCHIVO DE PARÁMETROS - CAPA DE CÓMPUTO DEL LABORATORIO
  // ============================================================
  // Este archivo entrega los valores específicos que el template
  // de VMs necesita para desplegar NICs, NSGs, Public IPs y VMs.
  //
  // IMPORTANTE:
  // - Esta es una copia comentada para lectura en VS Code.
  // - El archivo ejecutable sigue siendo: lab-vm-parameters.json
  // - La contraseña de administrador NO se incluyó aquí.
  // - La contraseña se solicita de forma segura en tiempo de ejecución
  //   desde el script PowerShell maestro.
  // ============================================================

  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    // ==========================================================
    // UBICACIÓN Y RED EXISTENTE
    // ==========================================================
    // La región debe coincidir con la VNet principal del laboratorio.
    "location": { "value": "eastus" },

    // Relación directa con la plantilla de red.
    // existingVirtualNetworkName debe coincidir con coreVnetName.
    "existingVirtualNetworkName": { "value": "CoreServicesVnet" },

    // existingSubnetName debe coincidir con coreDatabaseSubnetName.
    "existingSubnetName": { "value": "DatabaseSubnet" },

    // ==========================================================
    // RECURSOS DE LA VM 1
    // ==========================================================
    "vmName1": { "value": "testvm1" },
    "nicName1": { "value": "testvm1-nic" },
    "nsgName1": { "value": "testvm1-nsg" },
    "publicIpName1": { "value": "testvm1-pip" },

    // ==========================================================
    // RECURSOS DE LA VM 2
    // ==========================================================
    "vmName2": { "value": "testvm2" },
    "nicName2": { "value": "testvm2-nic" },
    "nsgName2": { "value": "testvm2-nsg" },
    "publicIpName2": { "value": "testvm2-pip" },

    // ==========================================================
    // CONFIGURACIÓN GENERAL DE LAS VMS
    // ==========================================================
    "vmSize": { "value": "Standard_DS1_v2" },
    "adminUsername": { "value": "TestUser" },
    "windowsSku": { "value": "2019-Datacenter" },
    "osDiskStorageAccountType": { "value": "StandardSSD_LRS" },

    // ==========================================================
    // SEGURIDAD DE ACCESO RDP
    // ==========================================================
    // En laboratorio se dejó "*" para facilitar la demo.
    // En producción debe cambiarse por una IP o rango administrativo.
    "rdpAllowedSourceAddressPrefix": { "value": "*" },

    // ==========================================================
    // TAGS COMUNES
    // ==========================================================
    "tags": {
      "value": {
        "Project": "ARM-Lab-Integral",
        "Environment": "Lab",
        "Owner": "IngenieroCalderon"
      }
    }
  }
}
