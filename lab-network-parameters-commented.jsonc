{
  // ============================================================
  // ARCHIVO DE PARÁMETROS - BASE DE RED DEL LABORATORIO
  // ============================================================
  // Este archivo entrega los valores concretos que la plantilla
  // lab-network-template.json necesita para ejecutarse.
  //
  // IMPORTANTE:
  // - Esta es una copia comentada para lectura en VS Code.
  // - El archivo ejecutable sigue siendo: lab-network-parameters.json
  // - No se debe usar este JSONC directamente para desplegar.
  // ============================================================

  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    // ==========================================================
    // NOMBRES DE VNETS
    // ==========================================================
    "coreVnetName": { "value": "CoreServicesVnet" },
    "manufacturingVnetName": { "value": "ManufacturingVnet" },
    "researchVnetName": { "value": "ResearchVnet" },

    // ==========================================================
    // REGIONES
    // ==========================================================
    // Core se despliega en East US.
    "coreLocation": { "value": "eastus" },
    // Manufacturing se despliega en West Europe.
    "manufacturingLocation": { "value": "westeurope" },
    // Research se despliega en Southeast Asia.
    "researchLocation": { "value": "southeastasia" },

    // ==========================================================
    // ADDRESS SPACES DE LAS VNETS
    // ==========================================================
    "coreAddressSpace": { "value": "10.20.0.0/16" },
    "manufacturingAddressSpace": { "value": "10.30.0.0/16" },
    "researchAddressSpace": { "value": "10.40.0.0/16" },

    // ==========================================================
    // SUBREDES DE CORESERVICESVNET
    // ==========================================================
    "coreGatewaySubnetName": { "value": "GatewaySubnet" },
    "coreGatewaySubnetPrefix": { "value": "10.20.0.0/27" },
    "coreSharedServicesSubnetName": { "value": "SharedServicesSubnet" },
    "coreSharedServicesSubnetPrefix": { "value": "10.20.10.0/24" },
    "coreDatabaseSubnetName": { "value": "DatabaseSubnet" },
    "coreDatabaseSubnetPrefix": { "value": "10.20.20.0/24" },
    "corePublicWebSubnetName": { "value": "PublicWebServiceSubnet" },
    "corePublicWebSubnetPrefix": { "value": "10.20.30.0/24" },

    // ==========================================================
    // SUBREDES DE MANUFACTURINGVNET
    // ==========================================================
    "manufacturingSystemSubnetName": { "value": "ManufacturingSystemSubnet" },
    "manufacturingSystemSubnetPrefix": { "value": "10.30.10.0/24" },
    "manufacturingSensorSubnet1Name": { "value": "SensorSubnet1" },
    "manufacturingSensorSubnet1Prefix": { "value": "10.30.20.0/24" },
    "manufacturingSensorSubnet2Name": { "value": "SensorSubnet2" },
    "manufacturingSensorSubnet2Prefix": { "value": "10.30.21.0/24" },
    "manufacturingSensorSubnet3Name": { "value": "SensorSubnet3" },
    "manufacturingSensorSubnet3Prefix": { "value": "10.30.22.0/24" },

    // ==========================================================
    // SUBRED DE RESEARCHVNET
    // ==========================================================
    "researchSystemSubnetName": { "value": "ResearchSystemSubnet" },
    "researchSystemSubnetPrefix": { "value": "10.40.40.0/24" },

    // ==========================================================
    // TAGS COMUNES DEL LABORATORIO
    // ==========================================================
    // Estas etiquetas se aplican a todos los recursos de red.
    "tags": {
      "value": {
        "Project": "ARM-Lab-Integral",
        "Environment": "Lab",
        "Owner": "IngenieroCalderon"
      }
    }
  }
}
